{%- comment -%} YaLegendCo floating tees. Add via Customize > Add section > "Floating tees (3D)". {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800;900&family=Figtree:wght@400;600&family=IBM+Plex+Mono:wght@500&display=swap">
<style>/* YaLegendCo floating-tee showcase. Night stage, summer-sun gold, one gradient "heat line". */
.yl{
  --yl-night:#0a0c11; --yl-night-2:#12151d; --yl-ink:#f4efe4; --yl-mute:#8e95a3;
  --yl-gold:#f2b544; --yl-red:#e2453c; --yl-sea:#4fb3d9; --yl-accent:#f2b544;
  --yl-display:"Big Shoulders Display","Arial Narrow",Impact,sans-serif;
  --yl-body:"Figtree","Segoe UI",Roboto,sans-serif;
  --yl-mono:"IBM Plex Mono",ui-monospace,Menlo,monospace;
  background:var(--yl-night); color:var(--yl-ink); font-family:var(--yl-body);
  overflow-x:clip; -webkit-font-smoothing:antialiased;
}
.yl *{box-sizing:border-box}
.yl a{color:inherit}
.yl :focus-visible{outline:2px solid var(--yl-gold);outline-offset:3px;border-radius:4px}
.yl-wrap{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.yl-eyebrow{font-family:var(--yl-mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--yl-mute)}

/* ---------- scroll show ---------- */
.yl-show{position:relative;height:520vh}
.yl-stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;
  display:grid;grid-template-rows:auto 1fr auto;isolation:isolate}
.yl-stage::before{content:"";position:absolute;inset:-20% -10% auto;height:90%;z-index:-2;
  background:radial-gradient(50% 55% at 50% 30%,color-mix(in srgb,var(--yl-accent) 26%,transparent),transparent 70%);
  transition:background .8s ease}
.yl-stage::after{content:"";position:absolute;left:0;right:0;bottom:0;height:42%;z-index:-1;
  background:linear-gradient(180deg,transparent,rgba(255,255,255,.03) 55%,rgba(255,255,255,.06))}
.yl-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding-top:calc(18px + env(safe-area-inset-top,0px))}
.yl-brand{font-family:var(--yl-display);font-weight:800;font-size:22px;letter-spacing:.04em;text-transform:uppercase;text-decoration:none}
.yl-brand b{color:var(--yl-gold)}
.yl-count{font-family:var(--yl-mono);font-size:12px;color:var(--yl-mute);font-variant-numeric:tabular-nums}
.yl-count strong{color:var(--yl-ink);font-weight:500}
.yl-head{position:absolute;left:0;right:0;top:12%;text-align:center;pointer-events:none;z-index:0}
.yl-head h1{margin:8px 0 0;font-family:var(--yl-display);font-weight:900;text-transform:uppercase;
  font-size:clamp(54px,15vw,190px);line-height:.82;letter-spacing:-.01em;text-wrap:balance;
  color:transparent;-webkit-text-stroke:1px rgba(244,239,228,.22)}
.yl-head h1 span{display:block;color:rgba(244,239,228,.07);-webkit-text-stroke:0}

.yl-ring{position:relative;perspective:1100px;perspective-origin:50% 40%}
.yl-tee{position:absolute;left:50%;top:50%;width:var(--yl-teew);margin-left:calc(var(--yl-teew)/-2);margin-top:calc(var(--yl-teew)*-0.62);
  transform-style:preserve-3d;will-change:transform,opacity;text-decoration:none}
.yl-float{animation:yl-bob 5.5s ease-in-out infinite;animation-delay:var(--yl-d,0s)}
.yl-tee svg{display:block;width:100%;height:auto;overflow:visible}
.yl-shadow{position:absolute;left:12%;right:12%;bottom:-16%;height:9%;border-radius:50%;
  background:radial-gradient(closest-side,rgba(0,0,0,.75),transparent);animation:yl-shadow 5.5s ease-in-out infinite;animation-delay:var(--yl-d,0s)}
@keyframes yl-bob{0%,100%{transform:translateY(0) rotateZ(-1.5deg) rotateY(-6deg)}50%{transform:translateY(-4%) rotateZ(1.5deg) rotateY(6deg)}}
@keyframes yl-shadow{0%,100%{transform:scale(1);opacity:.9}50%{transform:scale(.82);opacity:.55}}

.yl-plinth{position:absolute;left:50%;top:calc(50% + var(--yl-teew)*.5);width:calc(var(--yl-teew)*1.5);aspect-ratio:5/1;transform:translateX(-50%);z-index:-1;border-radius:50%;
  background:radial-gradient(closest-side,color-mix(in srgb,var(--yl-accent) 30%,transparent),transparent);
  box-shadow:0 0 0 1px rgba(255,255,255,.05) inset;transition:background .8s ease}

.yl-cap{text-align:center;padding-bottom:calc(22px + env(safe-area-inset-bottom,0px));display:grid;justify-items:center;gap:10px;z-index:2}
.yl-name{margin:0;font-family:var(--yl-display);font-weight:900;text-transform:uppercase;font-size:clamp(34px,8.5vw,68px);line-height:.9;letter-spacing:.01em;text-wrap:balance;min-height:1.8em;display:flex;align-items:flex-end;justify-content:center}
.yl-tag{margin:0;color:var(--yl-mute);font-size:15px;min-height:1.4em}
.yl-bar{width:min(320px,70vw);height:2px;background:rgba(255,255,255,.12);border-radius:2px;overflow:hidden}
.yl-bar i{display:block;height:100%;width:100%;transform-origin:left;transform:scaleX(var(--yl-p,0));
  background:linear-gradient(90deg,var(--yl-red),var(--yl-gold) 50%,var(--yl-sea))}
.yl-hint{font-family:var(--yl-mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--yl-mute)}
.yl-btn{display:inline-flex;align-items:center;gap:10px;padding:13px 22px;border-radius:999px;font-weight:600;font-size:15px;text-decoration:none;
  background:var(--yl-ink);color:var(--yl-night)!important;transition:transform .2s ease,background .2s ease}
.yl-btn:hover{transform:translateY(-2px);background:var(--yl-gold)}
.yl-btn--ghost{background:transparent;color:var(--yl-ink)!important;box-shadow:inset 0 0 0 1px rgba(244,239,228,.3)}
.yl-btn--ghost:hover{background:rgba(244,239,228,.08)}

/* ---------- marquee ---------- */
.yl-strip{border-block:1px solid rgba(255,255,255,.08);overflow:hidden;padding-block:16px;white-space:nowrap}
.yl-strip div{display:inline-flex;gap:40px;padding-right:40px;font-family:var(--yl-display);font-weight:800;font-size:clamp(22px,4vw,34px);text-transform:uppercase;animation:yl-marq 28s linear infinite}
.yl-strip span:nth-child(3n+2){color:var(--yl-gold)}
.yl-strip span:nth-child(3n){color:transparent;-webkit-text-stroke:1px var(--yl-ink)}
@keyframes yl-marq{to{transform:translateX(-100%)}}

/* ---------- range grid ---------- */
.yl-range{padding-block:72px 40px;max-width:1180px;margin-inline:auto}
.yl-range h2,.yl-end h2{margin:8px 0 0;font-family:var(--yl-display);font-weight:900;text-transform:uppercase;font-size:clamp(40px,9vw,88px);line-height:.88;text-wrap:balance}
.yl-range p.yl-lede{max-width:46ch;color:var(--yl-mute);font-size:16px;line-height:1.55;margin:14px 0 0}
.yl-grid{margin-top:36px;display:grid;grid-template-columns:repeat(auto-fill,minmax(clamp(150px,22%,400px),1fr));gap:18px}
.yl-card{position:relative;display:grid;gap:10px;padding:clamp(14px,3vw,22px);align-content:start;border-radius:22px;text-decoration:none;
  background:linear-gradient(180deg,var(--yl-night-2),#0d1016);box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);
  transform:perspective(800px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .25s ease,box-shadow .25s ease}
.yl-card:hover{box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--c) 55%,transparent),0 24px 60px -30px var(--c)}
.yl-card .yl-cardtee{width:78%;margin:0 auto;transform:translateZ(30px);transition:transform .4s cubic-bezier(.2,.8,.2,1)}
.yl-card:hover .yl-cardtee{transform:translateY(-6px) scale(1.04)}
.yl-card h3{margin:0;font-family:var(--yl-display);font-weight:800;font-size:clamp(20px,5vw,26px);text-transform:uppercase;line-height:1}
.yl-card p{margin:0;color:var(--yl-mute);font-size:14px}
.yl-card .yl-meta{display:flex;justify-content:space-between;align-items:center;font-family:var(--yl-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--yl-mute)}
.yl-card .yl-meta b{color:var(--c);font-weight:500}

/* ---------- facts + end ---------- */
.yl-facts{max-width:1180px;margin-inline:auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:1px;background:rgba(255,255,255,.08);border-radius:18px;overflow:hidden}
.yl-facts div{background:var(--yl-night);padding:24px 22px;display:grid;gap:6px}
.yl-facts strong{font-family:var(--yl-display);font-size:30px;font-weight:800;text-transform:uppercase;line-height:1}
.yl-facts span{color:var(--yl-mute);font-size:14px;line-height:1.5}
.yl-end{text-align:center;padding-block:90px 70px;display:grid;justify-items:center;gap:18px}
.yl-end h2 em{font-style:normal;color:var(--yl-gold)}
.yl-end .yl-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
.yl-foot{font-family:var(--yl-mono);font-size:11px;color:var(--yl-mute);letter-spacing:.08em;text-align:center;padding-block:0 32px}

.yl-ctrl{display:flex;align-items:center;gap:12px}
.yl-nav{width:46px;height:46px;border-radius:50%;border:0;cursor:pointer;font-size:22px;line-height:1;color:var(--yl-ink);background:rgba(244,239,228,.08);box-shadow:inset 0 0 0 1px rgba(244,239,228,.2);transition:background .2s ease}
.yl-nav:hover{background:rgba(244,239,228,.16)}
.yl--auto .yl-show{height:auto}
.yl--auto .yl-stage{position:relative;height:min(760px,calc(100vw * 1.9));min-height:600px}
@media (min-width:800px){.yl-show{height:600vh}.yl-head{top:16%}}
@media (prefers-reduced-motion:reduce){.yl-float,.yl-shadow,.yl-strip div{animation:none}.yl-card,.yl-card .yl-cardtee{transition:none}}

/* ---------- rail style: light studio, tees on hangers along a chrome rail ---------- */
.yl--rail{--yl-night:#e9ebef;--yl-night-2:#ffffff;--yl-ink:#14161b;--yl-mute:#6b7079;
  background:radial-gradient(120% 70% at 50% 35%,#fbfbfc,#e3e6eb 70%,#d6dae1)}
.yl--rail .yl-stage::before{background:radial-gradient(45% 40% at 50% 45%,color-mix(in srgb,var(--yl-accent) 14%,transparent),transparent 70%)}
.yl--rail .yl-stage::after{background:linear-gradient(180deg,transparent,rgba(20,22,27,.035) 60%,rgba(20,22,27,.07))}
.yl--rail .yl-head{display:none}
.yl--rail .yl-tee{top:0;margin-top:0;transform-origin:50% 0}
.yl--rail .yl-float{transform-origin:50% 0;animation-name:yl-sway}
.yl--rail .yl-hanger{display:block;width:62%;margin:0 auto -9%;position:relative;z-index:1}
.yl--rail .yl-tee svg:not(.yl-hanger){filter:drop-shadow(0 18px 22px rgba(20,22,27,.28))}
.yl--rail .yl-shadow{bottom:-10%;background:radial-gradient(closest-side,rgba(20,22,27,.28),transparent)}
.yl--rail .yl-railbar{position:absolute;left:0;top:0;pointer-events:none}
.yl--rail .yl-plinth{display:none}
.yl--rail .yl-btn{background:var(--yl-ink);color:#fff!important}
.yl--rail .yl-btn:hover{background:#2b2f38}
.yl--rail .yl-nav{color:var(--yl-ink);background:#fff;box-shadow:0 4px 14px rgba(20,22,27,.12)}
.yl--rail .yl-strip{border-color:rgba(20,22,27,.1)}
.yl--rail .yl-strip span:nth-child(3n+2){color:#b07a1e}
.yl--rail .yl-card{background:#fff;box-shadow:0 1px 0 rgba(20,22,27,.06),0 10px 30px -18px rgba(20,22,27,.35)}
.yl--rail .yl-facts{background:rgba(20,22,27,.1)}
.yl--rail .yl-facts div{background:#f4f5f7}
.yl--rail .yl-end h2 em{color:#b07a1e}
@keyframes yl-sway{0%,100%{transform:rotateZ(-1.6deg)}50%{transform:rotateZ(1.6deg)}}
</style>
{%- capture yl_json -%}[{%- for block in section.blocks -%}{%- liquid
  assign link = block.settings.link
  if block.settings.product != blank
    assign link = block.settings.product.url
  endif
  if link == blank
    assign link = routes.all_products_collection_url
  endif
  assign img = ''
  if block.settings.print != blank
    assign img = block.settings.print | image_url: width: 700
  endif
-%}{"name":{{ block.settings.name | json }},"tag":{{ block.settings.tagline | json }},"img":{{ img | json }},"tee":{{ block.settings.tee_colour | json }},"colour":{{ block.settings.tee_label | json }},"accent":{{ block.settings.accent | json }},"url":{{ link | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
{%- assign first = section.blocks.first -%}
{%- if section.blocks.size > 0 -%}
<div class="yl{% if section.settings.style == "rail" %} yl--rail{% endif %}">
  <script type="application/json" class="yl-data">{{ yl_json }}</script>
  <section class="yl-show" aria-label="Featured tees">
    <div class="yl-stage">
      <div class="yl-top yl-wrap"><a class="yl-brand" href="{{ routes.all_products_collection_url }}">Ya<b>Legend</b>Co</a><div class="yl-count" aria-hidden="true"><strong class="yl-cur">01</strong> / <span class="yl-tot">{{ section.blocks.size }}</span></div></div>
      <div class="yl-head"><div class="yl-eyebrow">{{ section.settings.eyebrow | escape }}</div><h1>{{ section.settings.headline_1 | escape }}<span>{{ section.settings.headline_2 | escape }}</span></h1></div>
      <div class="yl-ring"><div class="yl-plinth"></div></div>
      <div class="yl-cap yl-wrap">
        <p class="yl-name" aria-live="polite">{{ first.settings.name | escape }}</p>
        <p class="yl-tag">{{ first.settings.tagline | escape }}</p>
        <div class="yl-bar"><i></i></div>
        <div class="yl-ctrl"><button type="button" class="yl-nav yl-prev" aria-label="Previous tee">&lsaquo;</button><a class="yl-btn yl-buy" href="{{ first.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }} &rarr;</a><button type="button" class="yl-nav yl-next" aria-label="Next tee">&rsaquo;</button></div>
        <span class="yl-hint">Scroll to spin the rack</span>
      </div>
    </div>
  </section>
  <div class="yl-strip" aria-hidden="true"><div><span>Aussie Christmas</span><span>Printed on demand</span><span>Free delivery in Australia</span><span>Sizes S to 3XL</span><span>Bin chickens welcome</span><span>Thongs optional</span></div><div><span>Aussie Christmas</span><span>Printed on demand</span><span>Free delivery in Australia</span><span>Sizes S to 3XL</span><span>Bin chickens welcome</span><span>Thongs optional</span></div></div>
  {%- if section.settings.show_range -%}<section class="yl-range yl-wrap" aria-labelledby="yl-range-h">
    <div class="yl-eyebrow">The summer Christmas range</div>
    <h2 id="yl-range-h">Pick your legend</h2>
    <p class="yl-lede">Soft Gildan cotton crewnecks in black and navy. Each tee is printed when you order it, so nothing sits in a warehouse.</p>
    <div class="yl-grid"></div>
  </section>
  <div class="yl-wrap"><div class="yl-facts">
    <div><strong>Made to order</strong><span>Printed after you buy, usually shipped within a few days.</span></div>
    <div><strong>Free AU delivery</strong><span>No delivery fee anywhere in Australia.</span></div>
    <div><strong>S to 3XL</strong><span>Unisex fit, with roomy 2XL and 3XL sizes.</span></div>
  </div></div>{%- endif -%}
  <section class="yl-end yl-wrap">
    <div class="yl-eyebrow">Christmas orders</div>
    <h2>Be the legend<br>at <em>Chrissy lunch</em></h2>
    <div class="yl-btns"><a class="yl-btn" href="{{ routes.all_products_collection_url }}">Shop all tees &rarr;</a></div>
  </section>
  <div class="yl-foot yl-wrap">YaLegendCo &middot; Aussie humour tees &middot; Printed on demand</div>
</div>
<script>/* YaLegendCo floating-tee showcase. No libraries. Reads tee data from the JSON script inside each .yl root. */
(function(){
  var uid=0;
  function teeSVG(t){
    var id='ylg'+(uid++), c=t.tee||'#16181d';
    return '<svg viewBox="0 0 400 470" role="img" aria-label="'+esc(t.name)+' tee">'+
      '<defs><linearGradient id="'+id+'s" x1="0" x2="1">'+
      '<stop offset="0" stop-color="#000" stop-opacity=".5"/><stop offset=".22" stop-color="#000" stop-opacity="0"/>'+
      '<stop offset=".5" stop-color="#fff" stop-opacity=".07"/><stop offset=".72" stop-color="#000" stop-opacity="0"/>'+
      '<stop offset="1" stop-color="#000" stop-opacity=".55"/></linearGradient>'+
      '<linearGradient id="'+id+'v" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".07"/><stop offset=".6" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".35"/></linearGradient></defs>'+
      '<path d="M146 26 Q200 64 254 26 L334 50 Q368 66 398 118 L352 166 L322 146 L322 432 Q322 446 306 448 Q200 458 94 448 Q78 446 78 432 L78 146 L48 166 L2 118 Q32 66 66 50 Z" fill="'+c+'"/>'+
      '<path d="M146 26 Q200 64 254 26 L334 50 Q368 66 398 118 L352 166 L322 146 L322 432 Q322 446 306 448 Q200 458 94 448 Q78 446 78 432 L78 146 L48 166 L2 118 Q32 66 66 50 Z" fill="url(#'+id+'s)"/>'+
      '<path d="M146 26 Q200 64 254 26 L334 50 Q368 66 398 118 L352 166 L322 146 L322 432 Q322 446 306 448 Q200 458 94 448 Q78 446 78 432 L78 146 L48 166 L2 118 Q32 66 66 50 Z" fill="url(#'+id+'v)" stroke="#fff" stroke-opacity=".09" stroke-width="1.5"/>'+
      '<path d="M146 26 Q200 64 254 26" fill="none" stroke="#fff" stroke-opacity=".13" stroke-width="10" stroke-linecap="round"/>'+
      '<path d="M146 26 Q200 72 254 26" fill="none" stroke="#000" stroke-opacity=".35" stroke-width="2"/>'+
      '<path d="M78 146 Q90 120 84 96 M322 146 Q310 120 316 96 M110 440 Q130 380 118 300 M296 438 Q276 390 286 320" fill="none" stroke="#000" stroke-opacity=".22" stroke-width="5" stroke-linecap="round"/>'+
      '<image href="'+t.img+'" x="122" y="96" width="156" height="196" preserveAspectRatio="xMidYMin meet"/>'+
      '</svg>';
  }
  function esc(s){return String(s||'').replace(/[&<>"]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]})}

  function init(root){
    var dataEl=root.querySelector('.yl-data'); if(!dataEl) return;
    var tees; try{tees=JSON.parse(dataEl.textContent)}catch(e){return}
    if(!tees.length) return;
    var n=tees.length, show=root.querySelector('.yl-show'), stage=root.querySelector('.yl-stage'),
        ring=root.querySelector('.yl-ring'), nameEl=root.querySelector('.yl-name'), tagEl=root.querySelector('.yl-tag'),
        cur=root.querySelector('.yl-cur'), tot=root.querySelector('.yl-tot'), buy=root.querySelector('.yl-buy'),
        grid=root.querySelector('.yl-grid');
    if(tot) tot.textContent=String(n).padStart(2,'0');
    var rail=root.classList.contains('yl--rail'), railSvg=null;
    var HANGER='<svg class="yl-hanger" viewBox="0 0 400 120" aria-hidden="true"><path d="M200 70 L200 46 Q200 36 210 32 Q222 26 220 14 Q216 2 202 2 Q190 3 188 14" fill="none" stroke="#9aa0aa" stroke-width="7" stroke-linecap="round"/><path d="M200 70 L52 112 Q40 116 52 118 L348 118 Q360 116 348 112 Z" fill="#c9a77c" stroke="#a88758" stroke-width="3"/></svg>';
    if(rail){ railSvg=document.createElementNS('http://www.w3.org/2000/svg','svg'); railSvg.setAttribute('class','yl-railbar'); railSvg.setAttribute('aria-hidden','true'); ring.appendChild(railSvg); }
    var items=tees.map(function(t,i){
      var a=document.createElement('a'); a.className='yl-tee'; a.href=t.url||'#'; a.tabIndex=-1;
      a.innerHTML='<div class="yl-float" style="--yl-d:'+(-i*0.8)+'s">'+(rail?HANGER:'')+teeSVG(t)+'<div class="yl-shadow" style="--yl-d:'+(-i*0.8)+'s"></div></div>';
      ring.appendChild(a); return a;
    });
    if(grid) tees.forEach(function(t){
      var a=document.createElement('a'); a.className='yl-card'; a.href=t.url||'#'; a.style.setProperty('--c',t.accent||'#f2b544');
      a.innerHTML='<div class="yl-cardtee">'+teeSVG(t)+'</div><div class="yl-meta"><span>'+esc(t.colour||'Black')+' tee</span><b>Shop &rarr;</b></div><h3>'+esc(t.name)+'</h3><p>'+esc(t.tag)+'</p>';
      if(window.matchMedia('(hover:hover)').matches) {
        a.addEventListener('pointermove',function(e){var r=a.getBoundingClientRect();
          a.style.setProperty('--ry',((e.clientX-r.left)/r.width-.5)*14+'deg');a.style.setProperty('--rx',(.5-(e.clientY-r.top)/r.height)*10+'deg')});
        a.addEventListener('pointerleave',function(){a.style.setProperty('--ry','0deg');a.style.setProperty('--rx','0deg')});
      }
      grid.appendChild(a);
    });

    var active=-1, vw=0, teew=0, pos=0, target=0, auto=false, lastAct=0, hint=root.querySelector('.yl-hint');
    var still=window.matchMedia('(prefers-reduced-motion:reduce)').matches;
    // Embedded viewers (some app previews) grow the frame to the page height, so the page never scrolls.
    // Then the rack spins by itself and can be swiped instead.
    function detect(){
      var tall=window.innerHeight>Math.max(screen.height||0,900)*1.25;
      if(tall!==auto){ auto=tall; root.classList.toggle('yl--auto',auto); if(hint) hint.textContent=auto?'Swipe or tap the arrows':'Scroll to spin the rack'; }
    }
    function size(){ detect(); vw=stage.clientWidth; var rh=ring.clientHeight; teew=Math.max(130,Math.min(vw*(rail?0.56:0.46),rail?320:340,rh*(rail?0.62:0.66))); stage.style.setProperty('--yl-teew',teew+'px'); if(rail) drawRail(); }
    // rail mode: hooks sit on a bowed chrome rail; the rail dips toward the viewer in the middle
    function railY(x){ var W=Math.max(vw,1)/2, u=Math.min(1,Math.abs(x)/W); return Math.max(ring.clientHeight*0.05,(ring.clientHeight-teew*1.42)*0.42)+teew*0.09*(1-u*u); }
    function drawRail(){
      var w=ring.clientWidth, pts=[]; for(var i=0;i<=40;i++){ var x=-w/2+w*i/40*1; pts.push((x+w/2).toFixed(1)+','+railY(x).toFixed(1)); }
      railSvg.setAttribute('viewBox','0 0 '+w+' '+ring.clientHeight); railSvg.setAttribute('width',w); railSvg.setAttribute('height',ring.clientHeight);
      railSvg.innerHTML='<defs><linearGradient id="ylchrome" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff"/><stop offset=".45" stop-color="#b9bec7"/><stop offset=".55" stop-color="#7d838d"/><stop offset="1" stop-color="#e4e7ec"/></linearGradient></defs>'+
        '<polyline points="'+pts.join(' ')+'" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="9" stroke-linecap="round" transform="translate(0,6)"/>'+
        '<polyline points="'+pts.join(' ')+'" fill="none" stroke="url(#ylchrome)" stroke-width="8" stroke-linecap="round"/>';
    }
    function scrollP(){ var r=show.getBoundingClientRect(), span=show.offsetHeight-stage.offsetHeight; return span>0?Math.min(1,Math.max(0,-r.top/span)):0; }
    function go(d){ lastAct=Date.now();
      var k=Math.max(0,Math.min(n-1,Math.round(target)+d));
      if(auto){ target=k; return; }
      var span=show.offsetHeight-stage.offsetHeight, top=show.getBoundingClientRect().top+window.scrollY;
      window.scrollTo({top:top+span*k/(n-1)+1,behavior:still?'auto':'smooth'});
    }
    function render(){
      var p=pos/(n-1), R=Math.min(vw*0.62,560);
      stage.style.setProperty('--yl-p',p);
      if(rail){ items.forEach(function(el,i){
        var rel=i-pos, ab=Math.abs(rel), sp=teew*(vw<600?0.62:0.78);
        var x=rel*sp*(1-Math.min(ab,3)*0.08), s=Math.max(0.42,1-ab*0.3), hy=railY(x);
        var ry=Math.max(-50,Math.min(50,-rel*26));
        el.style.transform='translate3d('+x.toFixed(1)+'px,'+hy.toFixed(1)+'px,0) rotateY('+ry.toFixed(1)+'deg) scale('+s.toFixed(3)+')';
        el.style.opacity=ab>3.4?0:Math.max(0.2,1-ab*0.22).toFixed(3);
        el.style.zIndex=100-Math.round(ab*10);
      }); } else
      items.forEach(function(el,i){
        var rel=i-pos, a=rel*0.62, ab=Math.abs(rel);
        var x=Math.sin(a)*R, z=(Math.cos(a)-1)*R*1.1 - ab*40, y=ab*ab*6;
        var ry=Math.max(-60,Math.min(60,-rel*32)), s=ab<1?1.12-ab*0.12:1;
        el.style.transform='translate3d('+x.toFixed(1)+'px,'+y.toFixed(1)+'px,'+z.toFixed(1)+'px) rotateY('+ry.toFixed(1)+'deg) scale('+s.toFixed(3)+')';
        el.style.opacity=ab>3.2?0:Math.max(0.12,1-ab*0.32).toFixed(3);
        el.style.zIndex=100-Math.round(ab*10);
      });
      var k=Math.round(pos);
      if(k!==active){ active=k; var t=tees[k];
        nameEl.textContent=t.name; tagEl.textContent=t.tag||'';
        if(cur) cur.textContent=String(k+1).padStart(2,'0');
        if(buy) buy.href=t.url||'#';
        root.style.setProperty('--yl-accent',t.accent||'#f2b544');
        items.forEach(function(el,i){el.tabIndex=i===k?0:-1});
      }
    }
    function loop(){
      if(auto){
        if(!still && Date.now()-lastAct>3200){ lastAct=Date.now(); target=Math.round(target)+1; if(target>n-1) target=0; }
      } else target=scrollP()*(n-1);
      var d=target-pos; pos=Math.abs(d)<0.001?target:pos+d*(still?1:0.12);
      render(); requestAnimationFrame(loop);
    }
    // swipe (auto mode) and arrow buttons (both modes)
    var sx=null;
    stage.addEventListener('touchstart',function(e){ if(auto) sx=e.touches[0].clientX },{passive:true});
    stage.addEventListener('touchend',function(e){ if(sx===null) return; var dx=e.changedTouches[0].clientX-sx; sx=null; if(Math.abs(dx)>30) go(dx<0?1:-1) },{passive:true});
    var pv=root.querySelector('.yl-prev'), nx=root.querySelector('.yl-next');
    if(pv) pv.addEventListener('click',function(){go(-1)}); if(nx) nx.addEventListener('click',function(){go(1)});
    size(); target=auto?0:scrollP()*(n-1); pos=target; lastAct=Date.now(); render(); requestAnimationFrame(loop);
    window.addEventListener('resize',size);
  }
  function boot(){ document.querySelectorAll('.yl').forEach(function(r){ if(!r.dataset.ylReady){r.dataset.ylReady=1;init(r)} }) }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',boot); else boot();
  document.addEventListener('shopify:section:load',boot);
})();
</script>
{%- endif -%}

