---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { P } from '../../data/products';
const n = (t: string) => P.filter((p) => p.type === t).length;
const filters = [['all', 'All', P.length], ['top', 'Tops', n('top') + n('hoodie')], ['pant', 'Bottoms', n('pant')], ['dress', 'Dresses', n('dress')], ['shirt', 'Shirts', n('shirt')], ['shoe', 'Shoes', n('shoe')], ['new', 'New', P.filter((p) => p.tag === 'New').length]] as const;
---
<Base title="KORA — Shop all twelve pieces" description="Six tops and six bottoms in one palette. Heavy cotton basics, free delivery in Australia.">
  <section class="shop-head wrap">
    <span class="label r-fade">Drop 01 · Live now</span>
    <h1 data-split>One<br>palette<em>.</em></h1>
    <p class="measure r-fade" data-delay="0.2">Tops, bottoms, dresses, shirts and shoes, all in the same six colours. Anything goes with anything. Free delivery in Australia, 30-day returns.</p>
  </section>

  <div class="bar wrap" id="shop-bar">
    <div class="chips" role="tablist" aria-label="Filter">
      {filters.map(([k, t, n]) => <button type="button" class={k === 'all' ? 'on' : ''} data-f={k} role="tab" aria-selected={k === 'all' ? 'true' : 'false'}>{t}<sup>{n}</sup></button>)}
    </div>
    <div class="sort">
      <span class="label" id="shop-count">{P.length} pieces</span>
      <label class="label" for="sort">Sort</label>
      <select id="sort"><option value="feat">Featured</option><option value="asc">Price, low to high</option><option value="desc">Price, high to low</option><option value="new">New first</option></select>
    </div>
  </div>

  <section class="grid wrap" id="shop-grid">
    {P.map((p, i) => <ProductCard p={p} i={i} />)}
  </section>
  <p class="empty wrap label" id="shop-empty" hidden>Nothing in that filter yet. The next six arrive in Drop 02.</p>

  <section class="note wrap rule">
    <div><span class="label">Sizing</span><p>Everything is cut boxy. If you are between sizes, go down. <a href="/help/#size">Size guide</a></p></div>
    <div><span class="label">Fabric</span><p>280 gsm jersey, 400 gsm fleece, 12 oz denim. Garment washed so it does not shrink. <a href="/story/#fabric">About the cloth</a></p></div>
    <div><span class="label">Restocks</span><p>50 to 80 of each style. When a colour is gone, the next drop brings a new colour, not a restock.</p></div>
  </section>
</Base>

<style>
.shop-head{padding-top:140px;display:grid;grid-template-columns:1fr 1fr;gap:24px 40px;align-items:end}
.shop-head .label{grid-column:1/-1;display:block}
.shop-head p{color:var(--mute);justify-self:end}
.bar{position:sticky;top:0;z-index:5;margin-top:40px;padding-block:14px;display:flex;justify-content:space-between;align-items:center;gap:20px;background:color-mix(in srgb,var(--bone) 88%,transparent);backdrop-filter:blur(10px);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.chips{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;margin-inline:-6px}
.chips::-webkit-scrollbar{display:none}
.chips button{padding:8px 12px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;border:1px solid transparent;transition:border-color .4s,color .4s}
.chips button sup{font-size:9px;margin-left:4px;color:var(--mute)}
.chips button.on{border-color:var(--ink)}
.chips button:hover{color:var(--clay)}
.sort{display:flex;align-items:center;gap:14px;flex:0 0 auto}
.sort select{font:inherit;font-size:12px;letter-spacing:.04em;text-transform:uppercase;background:transparent;border:0;border-bottom:1px solid var(--ink);padding:4px 0;color:var(--ink);outline:none}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:36px 16px;padding-block:36px 0}
.grid :global(.pcard.off){display:none}
.empty{padding-block:60px;text-align:center}
.note{margin-top:var(--section);padding-block:40px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}
.note p{color:var(--mute);margin-top:10px;font-size:13px;max-width:34ch}
.note a{color:var(--ink);text-decoration:underline;text-underline-offset:3px}
@media (max-width:980px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:760px){
  .shop-head{grid-template-columns:1fr;padding-top:110px}
  .shop-head p{justify-self:start}
  .bar{flex-wrap:wrap;gap:10px;top:0}
  .sort{width:100%;justify-content:space-between}
  #shop-count{display:none}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 10px}
  .note{grid-template-columns:1fr;gap:20px}
}
</style>

<script>
  function wire() {
    const grid = document.getElementById('shop-grid'); if (!grid || grid.dataset.ready) return; grid.dataset.ready = '1';
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.pcard'));
    const chips = document.querySelectorAll<HTMLButtonElement>('#shop-bar [data-f]');
    const sort = document.getElementById('sort') as HTMLSelectElement;
    const count = document.getElementById('shop-count')!, empty = document.getElementById('shop-empty')!;
    let f = new URLSearchParams(location.search).get('f') || 'all';
    if (!Array.from(chips).some((c) => c.dataset.f === f)) f = 'all';
    function apply(push = true) {
      chips.forEach((c) => { const on = c.dataset.f === f; c.classList.toggle('on', on); c.setAttribute('aria-selected', String(on)); });
      let n = 0;
      cards.forEach((c) => {
        const t = c.dataset.type!, show = f === 'all' || (f === 'top' && (t === 'top' || t === 'hoodie')) || (f === 'new' && c.dataset.tag === 'New') || f === t;
        c.classList.toggle('off', !show); if (show) n++;
      });
      const s = sort.value;
      cards.slice().sort((a, b) => {
        if (s === 'asc') return +a.dataset.price! - +b.dataset.price!;
        if (s === 'desc') return +b.dataset.price! - +a.dataset.price!;
        if (s === 'new') return (b.dataset.tag === 'New' ? 1 : 0) - (a.dataset.tag === 'New' ? 1 : 0) || +a.dataset.i! - +b.dataset.i!;
        return +a.dataset.i! - +b.dataset.i!;
      }).forEach((c) => grid!.appendChild(c));
      count.textContent = `${n} piece${n === 1 ? '' : 's'}`;
      empty.hidden = n > 0;
      if (push) { const u = new URL(location.href); if (f === 'all') u.searchParams.delete('f'); else u.searchParams.set('f', f); history.replaceState(null, '', u); }
    }
    chips.forEach((c) => c.addEventListener('click', () => { f = c.dataset.f!; apply(); }));
    sort.addEventListener('change', () => apply(false));
    apply(false);
  }
  wire(); document.addEventListener('astro:page-load', wire);
</script>
