---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
---
<Base title="KORA — Heavy cotton, quiet shapes">

  <Hero />

  <section class="sec wrap two" id="looks">
    <div>
      <span class="label r-fade">01 · The idea</span>
      <h2 data-split>Twelve pieces.<br>One palette.<br>Any top, any bottom.</h2>
    </div>
    <p class="measure r-fade" data-delay="0.2">Six tops and six bottoms designed together, so anything you buy this year still fits with what you buy next year. No prints, no slogans. One woven label at the neck.</p>
  </section>

  <section class="wrap trio">
    <figure class="r-img" data-depth="0.06"><img src="/img/fabric.webp" alt="Charcoal 280 gsm cotton jersey, close" width="1024" height="1024" loading="lazy" /><figcaption class="label">280 gsm, combed</figcaption></figure>
    <figure class="r-img" data-depth="0.09"><img src="/img/label.webp" alt="Plain woven label at the neck of a charcoal tee" width="1024" height="1024" loading="lazy" /><figcaption class="label">Nothing extra</figcaption></figure>
    <figure class="r-img" data-depth="0.12"><img src="/img/flatlay.webp" alt="Tee, knit and denim folded on linen" width="1024" height="1024" loading="lazy" /><figcaption class="label">Twelve pieces</figcaption></figure>
  </section>

  <section class="sec wrap specimen rule">
    <span class="label r-fade">Type and spacing check</span>
    <h1 data-split>Display 128</h1>
    <h2 class="r-fade" data-delay="0.1">Title 48. Instrument Serif, regular, with <em>one italic word</em> in clay.</h2>
    <p class="measure r-fade" data-delay="0.2">Body 15, Inter Light. Running text stays under 40 characters a line on desktop and reads at arm's length on a phone. Labels are 10 px, tracked wide, uppercase.</p>
    <div class="swatches r-fade" data-delay="0.3">
      <span style="background:#f4f1ea">Bone</span><span style="background:#141414;color:#f4f1ea">Ink</span><span style="background:#b5552f;color:#f4f1ea">Clay</span><span style="background:#cfc8bb">Stone</span>
    </div>
  </section>

  <section class="sec wrap end rule">
    <h2 data-split>Step 3 done: the hero.<br>Next, <em>navigation</em> and the bag.</h2>
    <p class="measure r-fade">Reload the page to watch the opening again. If it feels right, say go and step 4 begins.</p>
  </section>

</Base>

<style>
.two{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end}
.two p{color:var(--mute)}
.two .label{display:block;margin-bottom:22px}
.trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:start}
.trio figure{margin:0;display:grid;gap:12px}
.trio figure:nth-child(2){margin-top:12vh}
.trio figure:nth-child(3){margin-top:4vh}
.trio .r-img{aspect-ratio:3/4;max-width:100%}
.trio img{width:100%;height:100%;object-fit:cover}
.specimen{display:grid;gap:28px}
.swatches{display:flex;gap:10px;flex-wrap:wrap}
.swatches span{display:grid;place-items:end start;width:120px;height:120px;padding:10px;border:1px solid var(--line);font-size:11px;letter-spacing:.12em;text-transform:uppercase}
.end{display:grid;gap:24px}
.end p{color:var(--mute)}
@media (max-width:760px){
  .two{grid-template-columns:1fr;gap:24px}
  .trio{grid-template-columns:1fr 1fr;gap:12px}
  .trio figure:nth-child(2),.trio figure:nth-child(3){margin-top:0}
  .trio figure:nth-child(3){grid-column:span 2;aspect-ratio:auto}
}
</style>
