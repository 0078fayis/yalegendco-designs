---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ShopTheLook from '../components/ShopTheLook.astro';
import DropGrid from '../components/DropGrid.astro';
import Fabric from '../components/Fabric.astro';
import Range from '../components/Range.astro';
import Workshop from '../components/Workshop.astro';
---
<Base title="KORA — Heavy cotton, quiet shapes">
  <Hero />

  <section class="sec wrap two" id="idea">
    <div>
      <span class="label r-fade">01 · The idea</span>
      <h2 data-split>Twelve pieces.<br>One palette.<br>Any top, any bottom.</h2>
    </div>
    <p class="measure r-fade" data-delay="0.2">Six tops and six bottoms designed together, so anything you buy this year still fits with what you buy next year. No prints, no slogans. One woven label at the neck.</p>
  </section>

  <ShopTheLook />
  <DropGrid />
  <Range />
  <Fabric />
  <Workshop />
</Base>

<style>
.two{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end;padding-bottom:0}
.two p{color:var(--mute)}
.two .label{display:block;margin-bottom:22px}
@media (max-width:760px){.two{grid-template-columns:1fr;gap:24px}}
</style>
