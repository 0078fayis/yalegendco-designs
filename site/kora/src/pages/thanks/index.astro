---
import Base from '../../layouts/Base.astro';
---
<Base title="KORA — You are on the list" description="Thanks. One email per drop.">
  <section class="tk wrap">
    <span class="label r-fade">Drop 02</span>
    <h1 data-split>You are<br>on the <em>list.</em></h1>
    <p class="measure r-fade" data-delay="0.2">One email when the next six pieces go live. No newsletters, no discounts, nothing else.</p>
    <div class="r-fade" data-delay="0.3"><a class="btn" href="/shop/">Back to the shop</a></div>
  </section>
</Base>
<style>
.tk{min-height:80svh;display:grid;align-content:end;gap:24px;padding-block:120px 80px}
.tk p{color:var(--mute)}
</style>
