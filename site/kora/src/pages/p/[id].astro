---
import Base from '../../layouts/Base.astro';
import { P, SIZES, money } from '../../data/products';
import { LOOKS } from '../../data/looks';
export function getStaticPaths() { return P.map((p) => ({ params: { id: p.id }, props: { p } })); }
const { p } = Astro.props;
const l = LOOKS[p.look - 1];
const top = p.type !== 'pant';
const mate = P.find((x) => x.id === (top ? l.bottom : l.top))!;
const pair = Math.round((p.price + mate.price) * 0.9 * 100) / 100;
const isDenim = p.fab.includes('denim');
const gallery = [
  { src: l.img, pos: `50% ${top ? 18 : 82}%`, alt: `${p.name} on model` },
  { src: l.cut, pos: '50% 50%', alt: `${l.name} look, full length`, cut: true },
  { src: isDenim ? '/img/denim.webp' : '/img/fabric.webp', pos: '50% 50%', alt: `${p.fab}, close` },
  { src: top ? '/img/label.webp' : '/img/flatlay.webp', pos: '50% 50%', alt: top ? 'Plain woven label at the neck' : 'Folded with the rest of the drop' },
];
const also = P.filter((x) => x.id !== p.id && x.id !== mate.id && (x.type !== 'pant') === top).slice(0, 4);
const care = isDenim ? 'Cold wash inside out, rarely. Line dry in shade. No tumble dry.' : 'Cold wash inside out, line dry in shade, warm iron on reverse. No tumble dry.';
---
<Base title={`${p.name} — KORA`} description={p.desc}>
  <nav class="crumb wrap label" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/shop/">Shop</a> / <span>{p.name}</span></nav>

  <section class="pdp wrap" data-id={p.id}>
    <div class="galwrap">
    <div class="gal" id="gal">
      {gallery.map((g, i) => (
        <figure class={`g ${g.cut ? 'cut' : ''}`} data-i={i}>
          <img src={g.src} alt={g.alt} style={`object-position:${g.pos}`} width="1200" height="1500" loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} />
          <figcaption class="label">{g.alt}</figcaption>
        </figure>
      ))}
    </div>
    <div class="dots" id="dots" aria-hidden="true">{gallery.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</div>
    </div>

    <aside class="buy">
      <span class="label">Drop 01 · {top ? 'Top' : 'Bottom'}{p.tag ? ` · ${p.tag}` : ''}</span>
      <h1>{p.name}</h1>
      <div class="price"><b>{money(p.price)}</b><span class="label">incl. GST · free delivery</span></div>

      <div class="opt">
        <div class="k label"><span>Colour · <span id="colname">{p.cols[0][0]}</span></span></div>
        <div class="swatches" id="sw">{p.cols.map((c, i) => <button type="button" class={i === 0 ? 'on' : ''} data-i={i} data-name={c[0]} aria-label={c[0]}><i style={`background:${c[1]}`}></i></button>)}</div>
      </div>

      <div class="opt">
        <div class="k label"><span id="sizek">Size</span><a href="/help/#size">Size guide</a></div>
        <div class="sizes" id="sizes">{SIZES.map((z) => <button type="button" data-z={z} class={z === '3XL' ? 'low' : ''}>{z}</button>)}</div>
        <span class="label hint" id="sizehint">Select a size. Boxy fit: size down for a closer fit.</span>
      </div>

      <button class="btn solid wide" id="pdp-add" type="button" data-id={p.id}><span>Add to bag</span><span>{money(p.price)} →</span></button>
      <div class="meta"><span><b class="ok">In stock</b> · ships from Melbourne in 1 business day</span><span>30-day returns · exchanges free</span></div>

      <div class="acc">
        <details open><summary>Details</summary><div class="body"><p>{p.desc}</p><ul><li>{p.fab}</li><li>Garment washed, no shrinkage</li><li>Plain woven label, flat seams</li><li>Made in small batches by one workshop</li></ul></div></details>
        <details><summary>Fabric and care</summary><div class="body">{p.fab}. {care}</div></details>
        <details><summary>Delivery and returns</summary><div class="body">Free tracked delivery in Australia, 2 to 7 business days. 30 days to return or exchange, unworn, with a prepaid label.</div></details>
      </div>

      <div class="pairbox">
        <div class="pair-pic"><img src={l.img} alt={`${mate.name} on model`} style={`object-position:50% ${top ? 82 : 18}%`} width="300" height="400" loading="lazy" /></div>
        <div>
          <span class="label">Complete the look · {l.name}</span>
          <h3>{mate.name}</h3>
          <p>10% off when you add both. {money(pair)} for the pair.</p>
          <button class="btn" id="pdp-pair" type="button" data-id={p.id} data-mate={mate.id}>Add both · {money(pair)}</button>
        </div>
      </div>
    </aside>
  </section>

  <section class="also wrap">
    <div class="also-head"><h2 data-split>You may<br>also <em>like.</em></h2><a class="btn r-fade" href="/shop/">All pieces</a></div>
    <div class="also-row">
      {also.map((x) => { const lx = LOOKS[x.look - 1]; return (
        <a class="card r-fade" href={`/p/${x.id}/`}>
          <div class="card-pic"><img src={lx.img} alt={x.name} style={`object-position:50% ${x.type !== 'pant' ? 18 : 82}%`} width="600" height="800" loading="lazy" /></div>
          <div class="card-meta"><span>{x.name}</span><span class="pr">{money(x.price)}</span></div>
        </a>
      ); })}
    </div>
  </section>
</Base>

<style>
.crumb{padding-top:88px;display:flex;gap:6px}
.crumb a:hover{color:var(--clay)}
.pdp{display:grid;grid-template-columns:1.25fr 1fr;gap:48px;padding-block:20px 0;align-items:start}
.galwrap{min-width:0}
.gal{display:grid;gap:12px;position:relative}
.g{margin:0;position:relative;aspect-ratio:4/5;overflow:hidden;background:var(--mist);max-width:100%}
.g img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease)}
.g.cut img{object-fit:contain;padding:6% 12% 0}
.g:hover img{transform:scale(1.03)}
.g figcaption{position:absolute;left:14px;bottom:12px;color:var(--ink);background:rgba(244,241,234,.85);padding:5px 8px}
.dots{display:none}
.buy{position:sticky;top:96px;display:grid;gap:22px;align-content:start}
.buy h1{font-size:clamp(36px,4vw,56px)}
.price{display:flex;gap:14px;align-items:baseline}
.price b{font-weight:400;font-size:18px}
.opt{display:grid;gap:10px}
.k{display:flex;justify-content:space-between}
.k a{text-decoration:underline;text-underline-offset:3px}
.swatches{display:flex;gap:10px}
.swatches button{width:30px;height:30px;border-radius:50%;border:1px solid transparent;display:grid;place-items:center;transition:border-color .4s}
.swatches button i{width:22px;height:22px;border-radius:50%;border:1px solid rgba(20,20,20,.15)}
.swatches button.on{border-color:var(--ink)}
.sizes{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.sizes button{height:42px;border:1px solid var(--line);font-size:12px;letter-spacing:.04em;transition:all .4s}
.sizes button:hover{border-color:var(--ink)}
.sizes button.on{background:var(--ink);color:var(--bone);border-color:var(--ink)}
.sizes button.low{color:var(--mute)}
.hint{color:var(--mute)}
.hint.warn{color:var(--clay)}
.btn.wide{width:100%;justify-content:space-between;padding-block:16px}
.meta{display:grid;gap:4px;font-size:12px;color:var(--mute)}
.meta .ok{font-weight:400;color:#3f7a4f}
.acc{border-top:1px solid var(--line)}
.acc details{border-bottom:1px solid var(--line)}
.acc summary{cursor:pointer;padding:14px 0;font-size:14px;list-style:none;display:flex;justify-content:space-between}
.acc summary::-webkit-details-marker{display:none}
.acc summary::after{content:"+";color:var(--mute)}
.acc details[open] summary::after{content:"–"}
.acc .body{padding:0 0 16px;font-size:13px;color:var(--mute);max-width:52ch;display:grid;gap:8px}
.acc .body ul{margin:0;padding-left:18px;display:grid;gap:3px}
.pairbox{display:grid;grid-template-columns:110px 1fr;gap:18px;align-items:center;padding:16px;border:1px solid var(--line);background:var(--bg)}
.pair-pic{aspect-ratio:3/4;overflow:hidden;background:var(--mist)}
.pair-pic img{width:100%;height:100%;object-fit:cover}
.pairbox h3{font-size:22px;margin-top:6px}
.pairbox p{font-size:13px;color:var(--mute);margin:6px 0 12px}
.also{padding-block:var(--section) 0}
.also-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px}
.also-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.card{display:grid;gap:10px;min-width:0}
.card-pic{aspect-ratio:3/4;overflow:hidden;background:var(--mist);max-width:100%}
.card-pic img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease)}
.card:hover .card-pic img{transform:scale(1.05)}
.card-meta{display:flex;justify-content:space-between;font-size:13px}
.card-meta .pr{color:var(--mute)}
@media (max-width:900px){
  .pdp{grid-template-columns:1fr;gap:24px}
  .gal{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:8px;margin-inline:calc(-1 * var(--gutter));padding-inline:var(--gutter);scrollbar-width:none}
  .gal::-webkit-scrollbar{display:none}
  .g{flex:0 0 86%;scroll-snap-align:center}
  .dots{display:flex;gap:6px;padding-top:12px}
  .dots i{width:18px;height:2px;background:var(--line)}
  .dots i.on{background:var(--ink)}
  .buy{position:static}
  .buy h1{font-size:40px}
  .also-row{grid-template-columns:repeat(2,minmax(0,1fr))}
}
</style>

<script>
  import { addToBag } from '../../scripts/ui';
  function wire() {
    const root = document.querySelector<HTMLElement>('.pdp'); if (!root || root.dataset.ready) return; root.dataset.ready = '1';
    let size = '';
    const hint = document.getElementById('sizehint')!, sizek = document.getElementById('sizek')!;
    document.getElementById('sw')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
      document.getElementById('colname')!.textContent = b.dataset.name!;
      Array.from(b.parentElement!.children).forEach((c) => c.classList.toggle('on', c === b));
    });
    document.getElementById('sizes')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('button'); if (!b) return;
      size = b.dataset.z!; Array.from(b.parentElement!.children).forEach((c) => c.classList.toggle('on', c === b));
      hint.textContent = ''; hint.classList.remove('warn'); sizek.textContent = 'Size · ' + size;
    });
    document.getElementById('pdp-add')!.addEventListener('click', (e) => {
      const b = e.currentTarget as HTMLElement;
      if (!size) { hint.textContent = 'Choose a size first.'; hint.classList.add('warn'); document.getElementById('sizes')!.scrollIntoView({ block: 'center', behavior: 'smooth' }); return; }
      addToBag(b.dataset.id!, size);
    });
    document.getElementById('pdp-pair')!.addEventListener('click', (e) => {
      const b = e.currentTarget as HTMLElement; const z = size || 'M';
      addToBag(b.dataset.id!, z); addToBag(b.dataset.mate!, z);
    });
    const gal = document.getElementById('gal')!, dots = document.querySelectorAll('#dots i');
    gal.addEventListener('scroll', () => { const i = Math.min(dots.length - 1, Math.round(gal.scrollLeft / (gal.scrollWidth / dots.length))); dots.forEach((d, k) => d.classList.toggle('on', k === i)); }, { passive: true });
  }
  wire(); document.addEventListener('astro:page-load', wire);
</script>
