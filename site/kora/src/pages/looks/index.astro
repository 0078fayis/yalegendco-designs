---
import Base from '../../layouts/Base.astro';
---
<Base title="KORA — Looks">
  <section class="sec wrap hold">
    <span class="label r-fade">Looks</span>
    <h1 data-split>Looks.<br><em>Coming</em> in a later step.</h1>
    <p class="measure r-fade" data-delay="0.2">Six looks, styled head to toe. The reel arrives in step 5.</p>
    <div class="r-fade" data-delay="0.3"><a class="btn" href="/">Back home</a></div>
  </section>
</Base>
<style>
.hold{min-height:80svh;display:grid;align-content:end;gap:24px;padding-top:120px}
.hold p{color:var(--mute)}
</style>
