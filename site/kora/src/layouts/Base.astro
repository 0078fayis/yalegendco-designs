---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Bag from '../components/Bag.astro';
interface Props { title?: string; description?: string; image?: string }
const { title = 'KORA', description = 'Heavy cotton basics in quiet shapes. Made in small batches by one workshop.', image = '/img/hero.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en-AU" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#f4f1ea" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KORA" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500&display=swap" />
  <ClientRouter fallback="swap" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <footer class="foot wrap">
    <div class="foot-top rule">
      <div><a class="logo" href="/">KORA</a><p class="measure">Heavy cotton basics in quiet shapes. Made in small batches by one workshop. Australia only, for now.</p></div>
      <div class="cols">
        <div><span class="label">Shop</span><a href="/shop/">All pieces</a><a href="/shop/?f=top">Tops</a><a href="/shop/?f=pant">Bottoms</a><a href="/shop/?f=dress">Dresses</a><a href="/shop/?f=shirt">Shirts</a><a href="/shop/?f=shoe">Shoes</a></div>
        <div><span class="label">Help</span><a href="/help/#delivery">Delivery</a><a href="/help/#returns">Returns</a><a href="/help/#size">Size guide</a></div>
        <div><span class="label">About</span><a href="/story/">Story</a><a href="/story/#pricing">Honest pricing</a><a href="/help/#contact">Contact</a></div>
      </div>
    </div>
    <div class="foot-bot"><span class="label">© 2026 KORA (working name) · Melbourne</span><span class="label">Concept preview · Model imagery AI-generated · Prices are examples</span></div>
  </footer>
  <Bag />
  <script src="../scripts/ui.ts"></script>
  <script src="../scripts/hero.ts"></script>
  <script src="../scripts/motion.ts"></script>
  <script src="../scripts/looks.ts"></script>
</body>
</html>

<style is:global>
.skip{position:absolute;left:-999px;top:8px;background:var(--ink);color:var(--bone);padding:8px 12px;z-index:100}
.skip:focus{left:8px}
html.lock,html.lock body{overflow:hidden}
#wipe{position:fixed;inset:0;z-index:90;background:var(--mist);pointer-events:none;transform:translateY(101%)}
#wipe.in{animation:wipein .6s var(--ease) forwards}
#wipe.out{animation:wipeout .7s var(--ease) forwards}
@keyframes wipein{from{transform:translateY(101%)}to{transform:translateY(0)}}
@keyframes wipeout{from{transform:translateY(0)}to{transform:translateY(-101%)}}
::view-transition-old(root),::view-transition-new(root){animation:none}
</style>
<style>
.foot{padding-block:0 40px}
.foot-top{display:grid;grid-template-columns:1.2fr 2fr;gap:40px;padding-block:48px}
.foot-top p{margin-top:14px;color:var(--mute);font-size:13px}
.logo{font-family:var(--sans);font-weight:500;letter-spacing:.34em;font-size:13px}
.cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.cols div{display:grid;gap:8px;align-content:start;font-size:13px}
.cols .label{margin-bottom:6px}
.foot-bot{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:18px;border-top:1px solid var(--line)}
@media (max-width:760px){.foot-top{grid-template-columns:1fr}.cols{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
