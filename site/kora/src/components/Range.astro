---
import { P, money, RANGE, sizesFor } from '../data/products';
const groups = [
  ['dress', 'Dresses', 'Eighteen dresses in the same cloth and colours. Loose, long, pockets where they should be. Tap one to take it off the rail.'],
  ['shirt', 'Shirts', 'Four shirts cut boxy. Two to wear open as a jacket, two for the heat.'],
] as const;
const shoes = RANGE('shoe');
// product data the in-place "open" card needs, without another request
const card = (p: typeof P[number]) => JSON.stringify({ id: p.id, name: p.name, price: p.price, fab: p.fab, desc: p.desc, cols: p.cols, sizes: sizesFor(p), img: p.img });
---
<section class="rng wrap" id="range">
  <div class="rng-head">
    <div><span class="label r-fade">03b · Now also</span><h2 data-split>Dresses, shirts<br>and <em>shoes.</em></h2></div>
    <p class="measure r-fade" data-delay="0.15">Same palette, same workshop, same rule: anything here goes with anything else. Shot on the hanger so you see the cut, not the styling.</p>
  </div>
  {groups.map(([t, name, blurb]) => (
    <div class="rng-row" data-row={t}>
      <div class="rng-side">
        <span class="label r-fade">{name} · {RANGE(t).length}</span>
        <p class="r-fade" data-delay="0.1">{blurb}</p>
        <a class="btn r-fade" data-delay="0.2" href={`/shop/?f=${t}`}>All {name.toLowerCase()}</a>
      </div>
      <div class="rail-wrap">
        <span class="bar-rail" aria-hidden="true"></span>
        <div class="rail">
          {RANGE(t).map((p, i) => (
            <a class="hang r-fade" href={`/p/${p.id}/`} data-delay={i * 0.08} data-open={card(p)}>
              <div class="hang-pic tilt" data-tilt><img src={p.img} alt={p.name} width="900" height="1200" loading="lazy" /></div>
              <div class="hang-meta"><span>{p.name}</span><span class="pr">{money(p.price)}</span></div>
            </a>
          ))}
        </div>
        <div class="fb" aria-live="polite"></div>
      </div>
    </div>
  ))}

  <div class="rng-row shoes-row" data-row="shoe" id="shoes">
    <div class="rng-side sh-side">
      <span class="label r-fade">Shoes · {shoes.length}</span>
      <div class="sh-title r-fade" data-delay="0.1">
        <span class="label" id="sh-no">01 / {String(shoes.length).padStart(2, '0')}</span>
        <h3 id="sh-name">{shoes[0].name}</h3>
        <span id="sh-price">{money(shoes[0].price)}</span>
        <a id="sh-link" href={`/p/${shoes[0].id}/`} class="lnk">View details</a>
      </div>
      <p class="r-fade" data-delay="0.15">Twelve plain shoes. Canvas, suede and leather, no logos, resoleable where it counts. Tap a pair to bring it down.</p>
      <a class="btn r-fade" data-delay="0.2" href="/shop/?f=shoe">All shoes</a>
    </div>
    <div class="sky r-fade" id="sky">
      {shoes.map((p, i) => (
        <button type="button" class="sh" data-i={i} data-open={card(p)} aria-label={p.name}>
          <img src={p.img!.replace('.webp', 'c.webp')} alt="" width="800" height="600" loading="lazy" draggable="false" />
        </button>
      ))}
      <div class="fb sh-fb" aria-live="polite"></div>
    </div>
  </div>
</section>

<style is:global>
.rng{padding-block:var(--section) 0}
.rng-head{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end;margin-bottom:48px}
.rng-head .label{display:block;margin-bottom:22px}
.rng-head p{color:var(--mute)}
.rng-row{display:grid;grid-template-columns:1fr 3.2fr;gap:30px;padding-block:32px;border-top:1px solid var(--line)}
.rng-side{display:grid;gap:14px;align-content:start;position:sticky;top:110px}
.rng-side p{color:var(--mute);font-size:13px;max-width:30ch}
.rng-side .btn{justify-self:start}
/* the rail */
.rail-wrap{position:relative;min-width:0}
.bar-rail{position:absolute;left:-6px;right:-6px;top:-10px;height:3px;border-radius:2px;background:linear-gradient(90deg,#b9b3a7,#dcd6ca 30%,#cfc8bb 70%,#aaa397);box-shadow:0 2px 3px rgba(20,20,20,.18);z-index:2;transition:opacity .5s}
.rail{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:none;padding-bottom:6px;mask-image:linear-gradient(90deg,#000 94%,transparent);transition:opacity .55s var(--ease),filter .55s var(--ease)}
.rail::-webkit-scrollbar{display:none}
.rail .hang{flex:0 0 clamp(170px,17vw,230px);scroll-snap-align:start}
.hang{display:grid;gap:10px;min-width:0}
.hang-pic{aspect-ratio:3/4;overflow:hidden;background:var(--mist);max-width:100%}
.hang-pic img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease)}
.hang .hang-pic{transform-origin:50% -20%}
.hang.in .hang-pic{animation:sway 2.6s var(--ease) both}
@keyframes sway{0%{rotate:-3deg}35%{rotate:2deg}65%{rotate:-.8deg}100%{rotate:0deg}}
.hang:hover .hang-pic img{transform:scale(1.05)}
.hang-meta{display:flex;justify-content:space-between;gap:10px;font-size:13px}
.hang-meta .pr{color:var(--mute)}
/* opened in place: the rail steps back, the piece comes forward with its card */
.rng-row.open .rail{opacity:0;filter:blur(6px);pointer-events:none}
.rng-row.open .bar-rail{opacity:.35}
.fb{position:absolute;inset:0;display:none;grid-template-columns:minmax(0,1fr) minmax(260px,.9fr);gap:28px;align-items:stretch;z-index:3}
.rng-row.open .fb{display:grid}
.fb-pic{position:relative;min-height:0}
.fb-pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 24px 30px rgba(20,20,20,.16))}
.fb-info{display:grid;gap:12px;align-content:center;align-self:center;min-width:0;opacity:0;transform:translateY(12px)}
.fb.in .fb-info{animation:nameup .8s .25s var(--ease) both}
.fb-info h3{font-size:clamp(24px,2.4vw,34px)}
.fb-info .pr{font-size:15px}
.fb-info p{color:var(--mute);font-size:13px;max-width:36ch}
.fb-k{display:flex;flex-wrap:wrap;gap:6px}
.fb-k button{min-width:38px;height:34px;padding:0 10px;border:1px solid var(--line);font-size:12px;transition:border-color .3s,background .3s,color .3s}
.fb-k button.on{border-color:var(--ink);background:var(--ink);color:var(--bone)}
.fb-k.sw button{width:30px;min-width:0;height:30px;padding:0;border-radius:50%;display:grid;place-items:center}
.fb-k.sw i{width:18px;height:18px;border-radius:50%;display:block;border:1px solid rgba(20,20,20,.15)}
.fb-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.fb-close{position:absolute;right:0;top:-6px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;display:inline-flex;gap:8px;align-items:center;padding:8px 0}
.fb-close span{font-size:16px;line-height:1}
.lnk{font-size:12px;letter-spacing:.06em;text-transform:uppercase;border-bottom:1px solid var(--ink);padding-bottom:2px;justify-self:start}
/* the shoe wall: pairs floating in a bright room */
.shoes-row{grid-template-columns:1fr 3.2fr;align-items:stretch}
.sh-title{display:grid;gap:8px}
.sh-title h3{font-size:clamp(30px,3.6vw,54px);line-height:.95;transition:opacity .3s}
.sh-title.swap h3,.sh-title.swap #sh-price{animation:nameup .6s var(--ease) both}
.sh-title #sh-price{font-size:15px;color:var(--mute)}
.sky{position:relative;height:clamp(420px,66vh,680px);background:linear-gradient(180deg,#fbfaf7 0%,#f1efe9 70%,#e9e6df 100%);overflow:hidden;min-width:0}
.sh{position:absolute;left:0;top:0;width:18%;margin:0;padding:0;border:0;background:none;cursor:pointer;transform-origin:50% 50%;will-change:transform,opacity,filter;transition:opacity .7s var(--ease),filter .7s var(--ease)}
.sh img{width:100%;height:auto;pointer-events:none;filter:drop-shadow(0 22px 22px rgba(20,20,20,.18));animation:bob var(--bobt,7s) var(--bobd,0s) ease-in-out infinite alternate}
@keyframes bob{0%{transform:translateY(-3%) rotate(-1.5deg)}100%{transform:translateY(3%) rotate(1.5deg)}}
.sh:hover img{filter:drop-shadow(0 30px 28px rgba(20,20,20,.22))}
.sky.focus .sh:not(.on){opacity:0;filter:blur(5px);pointer-events:none}
.sky.focus .sh.on img{animation:none;filter:drop-shadow(0 40px 36px rgba(20,20,20,.22))}
.sh-fb{grid-template-columns:minmax(0,1.1fr) minmax(240px,.8fr);padding:clamp(16px,3vw,40px)}
.sh-fb .fb-pic{opacity:0}
.sh-fb .fb-close{right:clamp(16px,3vw,40px);top:14px}
@media (prefers-reduced-motion:reduce){.sh img{animation:none}}
@media (max-width:760px){
  .rng-head{grid-template-columns:1fr;gap:20px;margin-bottom:28px}
  .rng-row,.shoes-row{grid-template-columns:1fr;gap:18px;padding-block:24px}
  .rng-side{position:static}
  .rail{scroll-snap-type:x mandatory;gap:10px;margin-inline:calc(-1 * var(--gutter));padding-inline:var(--gutter);mask-image:none}
  .rail .hang{flex:0 0 64%}
  .bar-rail{left:calc(-1 * var(--gutter));right:calc(-1 * var(--gutter))}
  .fb{grid-template-columns:1fr 1.15fr;gap:14px}
  .fb-info h3{font-size:22px}
  .fb-info p{display:none}
  .sky{height:clamp(420px,80vw,560px);margin-inline:calc(-1 * var(--gutter))}
  .sh{width:27%}
  .sh-fb{grid-template-columns:1fr;align-content:end;padding:16px var(--gutter)}
  .sh-fb .fb-info{gap:8px}
  .sh-fb .fb-info .label{display:none}
  .sh-fb .fb-pic{display:none}
}
</style>
