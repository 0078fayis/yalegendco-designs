---
import { P, money, RANGE } from '../data/products';
const groups = [
  ['dress', 'Dresses', 'Six dresses in the same cloth and colours. Loose, long, pockets where they should be.'],
  ['shirt', 'Shirts', 'Four shirts cut boxy. Two to wear open as a jacket, two for the heat.'],
  ['shoe', 'Shoes', 'Four plain shoes. Canvas, suede and leather, no logos, resoleable where it counts.'],
] as const;
---
<section class="rng wrap" id="range">
  <div class="rng-head">
    <div><span class="label r-fade">03b · Now also</span><h2 data-split>Dresses, shirts<br>and <em>shoes.</em></h2></div>
    <p class="measure r-fade" data-delay="0.15">Same palette, same workshop, same rule: anything here goes with anything else. Shot on the hanger so you see the cut, not the styling.</p>
  </div>
  {groups.map(([t, name, blurb], gi) => (
    <div class="rng-row">
      <div class="rng-side">
        <span class="label r-fade">{name} · {RANGE(t).length}</span>
        <p class="r-fade" data-delay="0.1">{blurb}</p>
        <a class="btn r-fade" data-delay="0.2" href={`/shop/?f=${t}`}>All {name.toLowerCase()}</a>
      </div>
      <div class="rail">
        {RANGE(t).map((p, i) => (
          <a class="hang r-fade" href={`/p/${p.id}/`} data-delay={i * 0.08}>
            <div class="hang-pic tilt" data-tilt><img src={p.img} alt={p.name} width="900" height="1200" loading="lazy" /></div>
            <div class="hang-meta"><span>{p.name}</span><span class="pr">{money(p.price)}</span></div>
          </a>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
.rng{padding-block:var(--section) 0}
.rng-head{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end;margin-bottom:48px}
.rng-head .label{display:block;margin-bottom:22px}
.rng-head p{color:var(--mute)}
.rng-row{display:grid;grid-template-columns:1fr 3.2fr;gap:30px;padding-block:32px;border-top:1px solid var(--line)}
.rng-side{display:grid;gap:14px;align-content:start;position:sticky;top:110px}
.rng-side p{color:var(--mute);font-size:13px;max-width:30ch}
.rng-side .btn{justify-self:start}
.rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:14px}
.hang{display:grid;gap:10px;min-width:0}
.hang-pic{aspect-ratio:3/4;overflow:hidden;background:var(--mist);max-width:100%}
.hang-pic img{width:100%;height:100%;object-fit:cover;transition:transform 1.4s var(--ease)}
.hang .hang-pic{transform-origin:50% -20%}
.hang.in .hang-pic{animation:sway 2.6s var(--ease) both}
@keyframes sway{0%{rotate:-3deg}35%{rotate:2deg}65%{rotate:-.8deg}100%{rotate:0deg}}
.hang:hover .hang-pic img{transform:scale(1.05)}
.hang-meta{display:flex;justify-content:space-between;gap:10px;font-size:13px}
.hang-meta .pr{color:var(--mute)}
@media (max-width:980px){.rail{grid-auto-columns:minmax(0,1fr)}}
@media (max-width:760px){
  .rng-head{grid-template-columns:1fr;gap:20px;margin-bottom:28px}
  .rng-row{grid-template-columns:1fr;gap:18px;padding-block:24px}
  .rng-side{position:static}
  .rail{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;margin-inline:calc(-1 * var(--gutter));padding-inline:var(--gutter);scrollbar-width:none}
  .rail::-webkit-scrollbar{display:none}
  .hang{flex:0 0 64%;scroll-snap-align:start}
}
</style>
