---
import { LOOKS } from '../data/looks';
import { P, money } from '../data/products';
const by = (id: string) => P.find((p) => p.id === id)!;
---
<section class="stl wrap" id="looks">
  <div class="stl-head">
    <div>
      <span class="label r-fade">02 · Try the look</span>
      <h2 data-split>Try the <em>Look.</em></h2>
    </div>
    <p class="measure r-fade" data-delay="0.2">Six looks, styled head to toe. Tap a model to step in, tap a pin to see the piece, or add the whole outfit in one go.</p>
  </div>

  <div class="stl-grid">
    <div class="stage-wrap r-fade">
      <div class="stage" id="stage" tabindex="0" aria-roledescription="carousel" aria-label="Looks">
        <div class="lk-tag" aria-hidden="true"><span class="label" id="lk-tagno">Look 01</span><strong id="lk-tagname">{LOOKS[0].name}</strong></div>
        <button class="lk-close" id="lk-close" type="button" aria-label="Back to all looks">Close <span>×</span></button>
        {LOOKS.map((l, i) => (
          <button type="button" class="fig" data-i={i} aria-label={l.name} style={`--cut:url(${l.cut})`}>
            <span class="shadow"></span><span class="sweep" aria-hidden="true"></span>
            <img src={l.cut} alt="" draggable="false" width="340" height="1000" loading={i === 0 ? 'eager' : 'lazy'} />
            <span class="pin" data-id={l.top} style={`left:${l.pins[0][0] * 100}%;top:${l.pins[0][1] * 100}%`} aria-hidden="true"></span>
            <span class="pin" data-id={l.bottom} style={`left:${l.pins[1][0] * 100}%;top:${l.pins[1][1] * 100}%`} aria-hidden="true"></span>
            <span class="view" aria-hidden="true">View</span>
          </button>
        ))}
        <span class="floor" aria-hidden="true"></span>
      </div>
      <div class="idx-row">
        <button class="arrow" id="prev" type="button" aria-label="Previous look">←</button>
        <div class="idx" id="idx">{LOOKS.map((l, i) => <button type="button" data-i={i}>{String(i + 1).padStart(2, '0')}<span>{l.name}</span></button>)}</div>
        <button class="arrow" id="next" type="button" aria-label="Next look">→</button>
        <i class="bar" id="bar"></i>
      </div>
    </div>

    <aside class="panel r-fade" data-delay="0.15" id="panel">
      <span class="label" id="lk-no">In this look · 01 / 06</span>
      <h3 id="lk-name">{LOOKS[0].name}</h3>
      <div class="pieces" id="pieces">
        {[by(LOOKS[0].top), by(LOOKS[0].bottom)].map((p, j) => (
          <div class="piece" data-id={p.id}>
            <span class="n">{j + 1}</span>
            <div class="th"><img src={LOOKS[0].img} alt="" style={`object-position:50% ${j ? 85 : 18}%`} width="56" height="72" /></div>
            <div><small>KORA · {j ? 'Bottom' : 'Top'}</small><strong><a href={`/p/${p.id}/`}>{p.name}</a></strong><span class="pr">{money(p.price)}</span></div>
            <button class="add" type="button" data-add={p.id} data-size="M" aria-label={`Add ${p.name}`}>+</button>
          </div>
        ))}
      </div>
      <div class="tot"><span>Complete the look · 10% off the pair</span><b id="lk-total">{money((by(LOOKS[0].top).price + by(LOOKS[0].bottom).price) * 0.9)}</b></div>
      <button class="btn solid wide" id="addlook" type="button"><span>Add full look to bag</span><span id="lk-cta">→</span></button>
    </aside>
  </div>
</section>

<style is:global>
.stl{padding-block:var(--section) 0}
.stl-head{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end;margin-bottom:40px}
.stl-head .label{display:block;margin-bottom:22px}
.stl-head p{color:var(--mute)}
.stl-grid{display:grid;grid-template-columns:1fr 360px;gap:40px;align-items:start}
.stage-wrap{min-width:0;position:relative}
/* the studio: a flat line-up on a white floor, like a lookbook wall */
.stage{position:relative;height:clamp(440px,62vh,660px);touch-action:pan-y;user-select:none;-webkit-user-select:none;cursor:grab;overflow:hidden;outline:none;background:linear-gradient(180deg,#fbfaf7 0%,#f3f1ec 72%,#ebe8e1 100%)}
.stage.drag{cursor:grabbing}
.stage.focus{cursor:default}
.fig{position:absolute;left:50%;bottom:30px;margin:0;transform-origin:50% 100%;will-change:transform,opacity,filter;transition:opacity .25s,filter .25s;border:0;background:none;padding:0;cursor:pointer}
.stage.focus .fig{transition:opacity .7s var(--ease),filter .7s var(--ease)}
.fig img{display:block;height:100%;width:auto;pointer-events:none}
.fig .shadow{position:absolute;left:50%;bottom:-12px;width:110%;height:24px;transform:translateX(-50%);background:radial-gradient(50% 50% at 50% 50%,rgba(20,20,20,.22),rgba(20,20,20,0) 70%);pointer-events:none}
.fig .view{position:absolute;left:50%;top:58%;width:54px;height:54px;margin:-27px 0 0 -27px;border-radius:50%;border:1px solid rgba(20,20,20,.45);background:rgba(244,241,234,.55);backdrop-filter:blur(6px);display:grid;place-items:center;font-size:9px;letter-spacing:.2em;text-transform:uppercase;opacity:0;transform:scale(.7);transition:opacity .5s,transform .5s var(--ease);pointer-events:none}
.fig.on .view{opacity:1;transform:none}
.stage.focus .fig.on .view,.fig.on:has(.pin:hover) .view{opacity:0;transform:scale(.7)}
.pin{position:absolute;z-index:3;left:0;top:0;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:rgba(244,241,234,.96);box-shadow:0 1px 6px rgba(0,0,0,.25);opacity:0;transform:scale(.6);transition:opacity .4s,transform .4s;pointer-events:none}
.stage.focus .fig.on .pin{opacity:1;transform:scale(1);pointer-events:auto;cursor:pointer}
.pin::after{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--ink)}
.pin.hot::after{background:var(--clay)}
@media (prefers-reduced-motion:no-preference){.stage.focus .fig.on .pin::before{content:"";position:absolute;inset:-6px;border-radius:50%;border:1px solid rgba(20,20,20,.35);animation:pulse 2.2s ease-out infinite}}
@keyframes pulse{0%{transform:scale(.6);opacity:.9}100%{transform:scale(1.5);opacity:0}}
/* arrival in the middle: settle, light sweep across the figure, name slides up */
.fig.land img{animation:land 1.1s var(--ease) both}
@keyframes land{0%{transform:none;filter:brightness(1)}40%{transform:translateY(-8px) scale(1.025);filter:brightness(1.06)}75%{transform:translateY(0) scale(.997)}100%{transform:none;filter:brightness(1)}}
.fig.land .shadow{animation:shadowland 1.1s var(--ease) both}
@keyframes shadowland{40%{transform:translateX(-50%) scale(.8);opacity:.6}}
.sweep{position:absolute;inset:0;pointer-events:none;opacity:0;-webkit-mask:var(--cut) center/100% 100% no-repeat;mask:var(--cut) center/100% 100% no-repeat;background:linear-gradient(100deg,transparent 38%,rgba(255,255,255,.75) 50%,transparent 62%);background-size:300% 100%;background-position:120% 0}
.fig.land .sweep{animation:sweep 1s .2s var(--ease) both}
@keyframes sweep{0%{opacity:.9;background-position:120% 0}100%{opacity:.9;background-position:-20% 0}}
.stage.focus .fig.on .pin{animation:pop .7s .35s var(--ease) both}
@keyframes pop{0%{transform:scale(.3)}55%{transform:scale(1.3)}100%{transform:scale(1)}}
#lk-name.swap{animation:nameup .7s var(--ease) both}
@keyframes nameup{0%{opacity:0;transform:translateY(14px)}100%{opacity:1;transform:none}}
.floor{position:absolute;left:0;right:0;bottom:30px;height:1px;background:linear-gradient(90deg,transparent,rgba(20,20,20,.18) 20%,rgba(20,20,20,.18) 80%,transparent);pointer-events:none}
.floor.pulse{animation:floorpulse 1s var(--ease)}
@keyframes floorpulse{35%{background:linear-gradient(90deg,transparent,rgba(20,20,20,.5) 30%,rgba(20,20,20,.5) 70%,transparent)}}
/* focus mode chrome */
.lk-tag{position:absolute;left:22px;top:20px;z-index:5;display:grid;gap:6px;opacity:0;transform:translateY(8px);transition:opacity .6s .2s,transform .6s .2s var(--ease);pointer-events:none}
.lk-tag strong{font-family:var(--serif);font-weight:400;font-size:26px;line-height:1}
.lk-close{position:absolute;right:16px;top:14px;z-index:5;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:8px 10px;display:inline-flex;gap:8px;align-items:center;opacity:0;pointer-events:none;transition:opacity .5s .2s}
.lk-close span{font-size:16px;line-height:1}
.stage.focus .lk-tag,.stage.focus .lk-close{opacity:1;transform:none;pointer-events:auto}
.idx-row{position:relative;display:flex;align-items:center;gap:16px;padding-block:14px;border-top:1px solid var(--line)}
.arrow{font-size:16px;padding:6px 8px}
.idx{display:flex;gap:18px;overflow:auto;scrollbar-width:none;flex:1;font-size:12px;letter-spacing:.06em}
.idx::-webkit-scrollbar{display:none}
.idx button{display:flex;gap:8px;color:var(--mute);white-space:nowrap;padding-block:4px;border-bottom:1px solid transparent;transition:color .4s}
.idx button span{display:none}
.idx button.on{color:var(--ink);border-bottom-color:var(--ink)}
.idx button.on span{display:inline}
.bar{position:absolute;left:0;top:-1px;height:1px;width:0;background:var(--ink);transition:width .25s linear}
.panel{display:grid;gap:14px;position:sticky;top:88px}
.panel h3{font-size:34px}
.pieces{display:grid;border-top:1px solid var(--line)}
.piece{display:grid;grid-template-columns:18px 56px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);transition:background .6s}
.piece.hl{background:var(--mist)}
.piece .n{font-size:11px;color:var(--mute)}
.piece .th{width:56px;height:72px;overflow:hidden;background:var(--mist)}
.piece .th img{width:100%;height:100%;object-fit:cover}
.piece small{display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute)}
.piece strong{display:block;font-weight:400;font-size:14px}
.piece .pr{font-size:13px;color:var(--mute)}
.piece .add{width:34px;height:34px;border:1px solid var(--line);border-radius:50%;font-size:18px;transition:background .4s,color .4s}
.piece .add:hover{background:var(--ink);color:var(--bone)}
.tot{display:flex;justify-content:space-between;font-size:13px;color:var(--mute)}
.tot b{color:var(--ink);font-weight:400}
.btn.wide{width:100%;justify-content:space-between}
@media (max-width:980px){.stl-grid{grid-template-columns:1fr}.panel{position:static}}
@media (max-width:760px){.stl-head{grid-template-columns:1fr;gap:20px;margin-bottom:24px}.stage{height:clamp(400px,56vh,560px);margin-inline:calc(-1 * var(--gutter));width:auto}.panel h3{font-size:28px}.lk-tag{left:var(--gutter)}.lk-tag strong{font-size:22px}}
</style>
