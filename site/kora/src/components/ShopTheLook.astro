---
import { LOOKS } from '../data/looks';
import { P, money } from '../data/products';
const by = (id: string) => P.find((p) => p.id === id)!;
---
<section class="stl wrap" id="looks">
  <div class="stl-head">
    <div>
      <span class="label r-fade">02 · Shop the look</span>
      <h2 data-split>Six looks,<br>styled <em>head to toe.</em></h2>
    </div>
    <p class="measure r-fade" data-delay="0.2">Drag through the looks. Tap a pin to see the piece, or add the whole outfit in one go and change sizes in the bag.</p>
  </div>

  <div class="stl-grid">
    <div class="stage-wrap r-fade">
      <div class="stage" id="stage" tabindex="0" aria-roledescription="carousel" aria-label="Looks">
        {LOOKS.map((l, i) => (
          <button type="button" class="fig" data-i={i} aria-label={l.name}>
            <span class="shadow"></span>
            <img src={l.cut} alt="" draggable="false" width="340" height="1000" loading={i === 0 ? 'eager' : 'lazy'} />
            <span class="pin" data-id={l.top} style={`left:${l.pins[0][0] * 100}%;top:${l.pins[0][1] * 100}%`} aria-hidden="true"></span>
            <span class="pin" data-id={l.bottom} style={`left:${l.pins[1][0] * 100}%;top:${l.pins[1][1] * 100}%`} aria-hidden="true"></span>
          </button>
        ))}
        <span class="floor" aria-hidden="true"></span>
      </div>
      <div class="idx-row">
        <button class="arrow" id="prev" type="button" aria-label="Previous look">←</button>
        <div class="idx" id="idx">{LOOKS.map((l, i) => <button type="button" data-i={i}>{String(i + 1).padStart(2, '0')}<span>{l.name}</span></button>)}</div>
        <button class="arrow" id="next" type="button" aria-label="Next look">→</button>
        <i class="bar" id="bar"></i>
      </div>
    </div>

    <aside class="panel r-fade" data-delay="0.15" id="panel">
      <span class="label" id="lk-no">In this look · 01 / 06</span>
      <h3 id="lk-name">{LOOKS[0].name}</h3>
      <div class="pieces" id="pieces">
        {[by(LOOKS[0].top), by(LOOKS[0].bottom)].map((p, j) => (
          <div class="piece" data-id={p.id}>
            <span class="n">{j + 1}</span>
            <div class="th"><img src={LOOKS[0].img} alt="" style={`object-position:50% ${j ? 85 : 18}%`} width="56" height="72" /></div>
            <div><small>KORA · {j ? 'Bottom' : 'Top'}</small><strong><a href={`/p/${p.id}/`}>{p.name}</a></strong><span class="pr">{money(p.price)}</span></div>
            <button class="add" type="button" data-add={p.id} data-size="M" aria-label={`Add ${p.name}`}>+</button>
          </div>
        ))}
      </div>
      <div class="tot"><span>Complete the look · 10% off the pair</span><b id="lk-total">{money((by(LOOKS[0].top).price + by(LOOKS[0].bottom).price) * 0.9)}</b></div>
      <button class="btn solid wide" id="addlook" type="button"><span>Add full look to bag</span><span id="lk-cta">→</span></button>
    </aside>
  </div>
</section>

<style is:global>
.stl{padding-block:var(--section) 0}
.stl-head{display:grid;grid-template-columns:1.3fr 1fr;gap:40px;align-items:end;margin-bottom:40px}
.stl-head .label{display:block;margin-bottom:22px}
.stl-head p{color:var(--mute)}
.stl-grid{display:grid;grid-template-columns:1fr 360px;gap:40px;align-items:start}
.stage-wrap{min-width:0;position:relative}
.stage{position:relative;height:clamp(440px,62vh,660px);touch-action:pan-y;user-select:none;-webkit-user-select:none;cursor:grab;overflow:hidden;outline:none}
.stage.drag{cursor:grabbing}
.fig{position:absolute;left:50%;bottom:34px;margin:0;transform-origin:50% 100%;will-change:transform,opacity,filter;transition:transform .9s var(--ease),opacity .7s,filter .7s;border:0;background:none;padding:0;cursor:pointer}
.fig img{display:block;height:100%;width:auto;pointer-events:none}
.fig .shadow{position:absolute;left:50%;bottom:-14px;width:120%;height:28px;transform:translateX(-50%);background:radial-gradient(50% 50% at 50% 50%,rgba(20,20,20,.2),rgba(20,20,20,0) 70%);pointer-events:none}
.pin{position:absolute;z-index:3;left:0;top:0;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;background:rgba(244,241,234,.96);box-shadow:0 1px 6px rgba(0,0,0,.25);opacity:0;transform:scale(.6);transition:opacity .4s,transform .4s;pointer-events:none}
.fig.on .pin{opacity:1;transform:scale(1);pointer-events:auto;cursor:pointer}
.pin::after{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--ink)}
.pin.hot::after{background:var(--clay)}
@media (prefers-reduced-motion:no-preference){.fig.on .pin::before{content:"";position:absolute;inset:-6px;border-radius:50%;border:1px solid rgba(20,20,20,.35);animation:pulse 2.2s ease-out infinite}}
@keyframes pulse{0%{transform:scale(.6);opacity:.9}100%{transform:scale(1.5);opacity:0}}
.floor{position:absolute;left:0;right:0;bottom:34px;height:1px;background:linear-gradient(90deg,transparent,var(--line) 20%,var(--line) 80%,transparent)}
.idx-row{position:relative;display:flex;align-items:center;gap:16px;padding-block:14px;border-top:1px solid var(--line)}
.arrow{font-size:16px;padding:6px 8px}
.idx{display:flex;gap:18px;overflow:auto;scrollbar-width:none;flex:1;font-size:12px;letter-spacing:.06em}
.idx::-webkit-scrollbar{display:none}
.idx button{display:flex;gap:8px;color:var(--mute);white-space:nowrap;padding-block:4px;border-bottom:1px solid transparent;transition:color .4s}
.idx button span{display:none}
.idx button.on{color:var(--ink);border-bottom-color:var(--ink)}
.idx button.on span{display:inline}
.bar{position:absolute;left:0;top:-1px;height:1px;width:0;background:var(--ink);transition:width .25s linear}
.panel{display:grid;gap:14px;position:sticky;top:88px}
.panel h3{font-size:34px}
.pieces{display:grid;border-top:1px solid var(--line)}
.piece{display:grid;grid-template-columns:18px 56px 1fr auto;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);transition:background .6s}
.piece.hl{background:var(--mist)}
.piece .n{font-size:11px;color:var(--mute)}
.piece .th{width:56px;height:72px;overflow:hidden;background:var(--mist)}
.piece .th img{width:100%;height:100%;object-fit:cover}
.piece small{display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute)}
.piece strong{display:block;font-weight:400;font-size:14px}
.piece .pr{font-size:13px;color:var(--mute)}
.piece .add{width:34px;height:34px;border:1px solid var(--line);border-radius:50%;font-size:18px;transition:background .4s,color .4s}
.piece .add:hover{background:var(--ink);color:var(--bone)}
.tot{display:flex;justify-content:space-between;font-size:13px;color:var(--mute)}
.tot b{color:var(--ink);font-weight:400}
.btn.wide{width:100%;justify-content:space-between}
@media (max-width:980px){.stl-grid{grid-template-columns:1fr}.panel{position:static}}
@media (max-width:760px){.stl-head{grid-template-columns:1fr;gap:20px;margin-bottom:24px}.stage{height:clamp(400px,56vh,560px)}.panel h3{font-size:28px}}
</style>
