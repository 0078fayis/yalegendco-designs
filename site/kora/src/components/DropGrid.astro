---
import { P, money } from '../data/products';
import { LOOKS } from '../data/looks';
const items = P.slice(0, 8);
---
<section class="drop wrap" id="drop">
  <div class="drop-head">
    <div><span class="label r-fade">03 · Drop 01</span><h2 data-split>Twelve pieces.<br>One palette.</h2></div>
    <a class="btn r-fade" href="/shop/">All pieces</a>
  </div>
  <div class="cards">
    {items.map((p, i) => { const l = LOOKS[p.look - 1]; const top = p.type !== 'pant'; return (
      <a class="card r-fade" href={`/p/${p.id}/`} style={`--d:${(i % 4) * 0.08}s`} data-delay={(i % 4) * 0.08}>
        <div class="card-pic">
          <img class="a" src={l.img} alt={`${p.name} on model`} style={`object-position:50% ${top ? 18 : 82}%`} width="600" height="1200" loading="lazy" />
          <img class="b" src={l.cut} alt="" width="340" height="1000" loading="lazy" />
          {p.tag && <span class="tag label">{p.tag}</span>}
          <button class="quick" type="button" data-add={p.id} data-size="M" aria-label={`Add ${p.name} in M`}>Quick add · M</button>
        </div>
        <div class="card-meta"><span>{p.name}</span><span class="pr">{money(p.price)}</span></div>
        <div class="sw">{p.cols.map((c) => <i style={`background:${c[1]}`} title={c[0]}></i>)}</div>
      </a>
    ); })}
  </div>
</section>

<style>
.drop{padding-block:var(--section) 0}
.drop-head{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:36px}
.drop-head .label{display:block;margin-bottom:22px}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px 16px}
.card{display:grid;gap:10px;min-width:0}
.card-pic{position:relative;aspect-ratio:3/4;overflow:hidden;background:var(--mist);max-width:100%}
.card-pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:opacity .8s var(--ease),transform 1.4s var(--ease)}
.card-pic .b{opacity:0;object-fit:contain;padding:8% 10% 0;transform:scale(1.04)}
.card:hover .card-pic .a{opacity:0;transform:scale(1.04)}
.card:hover .card-pic .b{opacity:1;transform:none}
.tag{position:absolute;left:12px;top:12px;background:var(--bone);padding:5px 8px;color:var(--ink)}
.quick{position:absolute;left:12px;right:12px;bottom:12px;padding:12px;background:var(--bone);font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:0;transform:translateY(8px);transition:opacity .5s,transform .5s var(--ease)}
.card:hover .quick{opacity:1;transform:none}
.quick:hover{background:var(--ink);color:var(--bone)}
.card-meta{display:flex;justify-content:space-between;gap:12px;font-size:13px}
.card-meta .pr{color:var(--mute)}
.sw{display:flex;gap:6px}
.sw i{width:10px;height:10px;border-radius:50%;border:1px solid rgba(20,20,20,.12)}
@media (max-width:980px){.cards{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:760px){.cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 10px}.drop-head{margin-bottom:24px}.quick{opacity:1;transform:none;padding:10px;font-size:10px}}
</style>
