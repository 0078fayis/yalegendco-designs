---
const path = Astro.url.pathname;
const links = [['/shop/', 'Shop'], ['/looks/', 'Looks'], ['/story/', 'Story'], ['/help/', 'Help']];
---
<header class="top wrap" id="top-bar" transition:persist="header">
  <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="menu"><span class="lines" aria-hidden="true"><i></i><i></i></span><span class="menu-word">Menu</span></button>
  <a class="logo" href="/">KORA</a>
  <div class="right">
    <nav class="nav" aria-label="Primary">
      {links.slice(0, 3).map(([h, t]) => <a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{t}</a>)}
    </nav>
    <button class="bag-btn" id="bag-btn" type="button" aria-controls="bag" aria-expanded="false">Bag <span id="bag-count">0</span></button>
  </div>
</header>

<div class="menu" id="menu" aria-hidden="true" transition:persist="menu">
  <div class="menu-inner wrap">
    <nav class="menu-links" aria-label="Menu">
      {links.map(([h, t], i) => <a href={h} style={`--i:${i}`}><span class="r-line"><span>{t}</span></span></a>)}
    </nav>
    <div class="menu-side">
      <div class="menu-pic"><img src="/img/portrait2.webp" alt="" width="1152" height="1536" loading="lazy" /></div>
      <div class="menu-meta">
        <span class="label">Drop 01 · Live now</span>
        <p>Twelve pieces, six looks. Free delivery in Australia, 30-day returns.</p>
        <a class="label" href="/help/#contact">hello@kora.example</a>
      </div>
    </div>
  </div>
  <div class="menu-foot wrap"><span class="label">Melbourne · AEDT</span><span class="label" id="menu-time"></span><span class="label">Working name · Concept</span></div>
</div>

<style>
.top{position:fixed;inset:0 0 auto;z-index:60;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:68px;padding-top:env(safe-area-inset-top,0px);transition:transform .6s var(--ease),background .6s var(--ease)}
.top::before{content:"";position:absolute;inset:0;background:linear-gradient(var(--bone) 55%,rgba(244,241,234,0));opacity:1;transition:opacity .6s;z-index:-1}
.top.solid::before{background:var(--bone);border-bottom:1px solid var(--line)}
.top.hide{transform:translateY(-100%)}
.top.menu-open{transform:none;background:transparent}
.top.menu-open::before{opacity:0}
.logo{font-family:var(--sans);font-weight:500;letter-spacing:.34em;font-size:13px;justify-self:center}
.right{display:flex;justify-content:flex-end;align-items:center;gap:28px}
.nav{display:flex;gap:28px;font-size:12px;letter-spacing:.06em;text-transform:uppercase}
.nav a{position:relative;padding-block:4px}
.nav a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:1px;background:currentColor;transition:right .5s var(--ease)}
.nav a:hover::after,.nav a[aria-current]::after{right:0}
.menu-btn{display:flex;align-items:center;gap:10px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;justify-self:start}
.lines{display:grid;gap:5px;width:18px}
.lines i{display:block;height:1px;background:currentColor;transition:transform .5s var(--ease),width .5s var(--ease)}
.lines i:last-child{width:12px}
.menu-open .lines i:first-child{transform:translateY(3px) rotate(45deg)}
.menu-open .lines i:last-child{width:18px;transform:translateY(-3px) rotate(-45deg)}
.bag-btn{font-size:12px;letter-spacing:.06em;text-transform:uppercase;display:flex;gap:8px;align-items:center}
.bag-btn span{display:grid;place-items:center;min-width:20px;height:20px;padding-inline:5px;border-radius:10px;background:var(--ink);color:var(--bone);font-size:10px;transition:transform .4s var(--ease)}
.bag-btn.bump span{transform:scale(1.25)}
@media (max-width:760px){.nav{display:none}.menu-word{display:none}}

.menu{position:fixed;inset:0;z-index:55;background:var(--bone);clip-path:inset(0 0 100% 0);transition:clip-path .9s var(--ease);visibility:hidden}
.menu.open{clip-path:inset(0 0 0% 0);visibility:visible}
.menu-inner{height:100%;display:grid;grid-template-columns:1.4fr 1fr;align-items:end;gap:40px;padding-top:68px;padding-bottom:88px}
.menu-links{display:grid;gap:2px}
.menu-links a{font-family:var(--serif);font-size:clamp(48px,8vw,112px);line-height:1;letter-spacing:-.02em}
.menu-links a .r-line>span{transform:translateY(110%);transition:transform 1s var(--ease) calc(.25s + var(--i) * .08s)}
.menu.open .menu-links a .r-line>span{transform:none}
.menu-links a:hover{color:var(--clay)}
.menu-side{display:grid;grid-template-columns:140px 1fr;gap:20px;align-items:end;opacity:0;transform:translateY(16px);transition:opacity .8s .6s,transform .8s var(--ease) .6s}
.menu.open .menu-side{opacity:1;transform:none}
.menu-pic{aspect-ratio:3/4;overflow:hidden;max-width:100%}
.menu-pic img{width:100%;height:100%;object-fit:cover}
.menu-meta{display:grid;gap:10px;font-size:13px;color:var(--mute)}
.menu-foot{position:absolute;left:0;right:0;bottom:0;height:60px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);opacity:0;transition:opacity .6s .8s}
.menu.open .menu-foot{opacity:1}
@media (max-width:760px){
  .menu-inner{grid-template-columns:1fr;align-content:end;gap:28px;padding-bottom:80px}
  .menu-side{grid-template-columns:96px 1fr}
  .menu-links a{font-size:clamp(44px,13vw,72px)}
}
</style>
